# Database (docker compose zet deze zelf voor de app-container)
DATABASE_URL=postgres://golf:golf@localhost:5439/golf
POSTGRES_PASSWORD=change-me

# Gemini API (alleen op de server!)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Map voor geüploade scorekaarten
UPLOAD_DIR=./data/uploads

# Publieke URL (voor uitnodigingslinks) en domein voor de optionele Caddy-proxy
APP_URL=http://localhost:3470
DOMAIN=golf.example.nl

# Poort waarop de app op de host luistert (docker compose)
APP_PORT=3470
